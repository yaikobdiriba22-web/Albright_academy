rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*@albright\\.edu\\.et$')) ||
        request.auth.token.email == 'yaikobdiriba22@gmail.com'
      );
    }

    function isTeacher() {
      return isSignedIn() && exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }

    function isParent() {
      return isSignedIn() && exists(/databases/$(database)/documents/parents/$(request.auth.uid));
    }

    function isStudent() {
      return isSignedIn() && exists(/databases/$(database)/documents/students/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow write: if isAdmin();
    }

    // Students collection
    match /students/{studentId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        isTeacher() ||
        request.auth.uid == studentId ||
        (isParent() && resource.data.parentId == request.auth.uid)
      );
      allow write: if isAdmin();
    }

    // Teachers collection
    match /teachers/{teacherId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Parents collection
    match /parents/{parentId} {
      allow read: if isSignedIn() && (isOwner(parentId) || isAdmin() || isTeacher());
      allow write: if isAdmin();
    }

    // Academic Structure: Classes, Sections, Subjects
    match /classes/{classId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /sections/{sectionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /subjects/{subjectId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Enrollments
    match /enrollments/{enrollmentId} {
      allow read: if isSignedIn() && (isAdmin() || isTeacher());
      allow write: if isAdmin();
    }

    // Attendance records
    match /attendances/{attendanceId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        isTeacher() ||
        (isStudent() && resource.data.studentId == request.auth.uid) ||
        (isParent() && resource.data.parentId == request.auth.uid)
      );
      allow create, update: if isSignedIn() && (isAdmin() || isTeacher());
      allow delete: if isAdmin();
    }

    // Assignments
    match /assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && (isAdmin() || isTeacher());
    }

    // Exams & Assessments
    match /exams/{examId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && (isAdmin() || isTeacher());
    }

    // Academic Results
    match /results/{resultId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        isTeacher() ||
        (isStudent() && resource.data.studentId == request.auth.uid) ||
        (isParent() && resource.data.parentId == request.auth.uid)
      );
      allow create, update: if isSignedIn() && (isAdmin() || isTeacher());
      allow delete: if isAdmin();
    }

    // Fees & Payments
    match /fees/{feeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (isParent() && resource.data.parentId == request.auth.uid) ||
        (isStudent() && resource.data.studentId == request.auth.uid)
      );
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Public school settings & news
    match /schoolSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
