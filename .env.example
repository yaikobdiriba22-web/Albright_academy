# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Database Configuration (PostgreSQL / SQLite)
DATABASE_URL="postgresql://user:password@localhost:5432/albright_academy"

# Authentication Secret for JWT and sessions
AUTH_SECRET="your-super-secret-auth-key-change-in-production"

# Public site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional Cloudinary / External Media Storage
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

